# Copy to .env and edit. Real environment variables always override this file. Never commit .env.

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1            # use 0.0.0.0 only behind a platform/proxy that provides HTTPS
PORT=8000
APP_ENV=development       # "production" disables `python run.py seed`
DATA_DIR=./data           # SQLite database + uploads live here (put it on a persistent disk)
MAX_UPLOAD_MB=5
SESSION_DAYS=14
COOKIE_SECURE=0           # set 1 when served over HTTPS
TRUST_PROXY=0             # set 1 behind a reverse proxy so rate limits use the real client IP
ALLOWED_ORIGINS=          # comma-separated extra origins allowed for state-changing requests (usually empty)

# --- Rate limits (requests per minute) -------------------------------------
RATE_AUTH_PER_MIN=10
RATE_ANALYZE_PER_MIN=6
RATE_UPLOAD_PER_MIN=20
WORKERS=2                 # background analysis threads

# --- AI provider (leave all keys empty for demo mode) ----------------------
# auto = first configured of anthropic, openai (with a key), gemini; otherwise demo mode.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=           # Google AI Studio has offered a free tier; check its current limits
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=           # not needed for local servers such as Ollama
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # Ollama: http://127.0.0.1:11434/v1 with OPENAI_MODEL=llama3.1
# Model names change over time. If a provider returns "model not found", check its docs and update the *_MODEL value.
